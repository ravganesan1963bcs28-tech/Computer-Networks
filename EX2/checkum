#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#define SEGMENT_SIZE 8

unsigned char generate_block_checksum(const char *data_stream, int total_blocks) {
    unsigned long running_total = 0;
    char sub_block[SEGMENT_SIZE + 1];
    int i;

    for (i = 0; i < total_blocks; i++) {
        strncpy(sub_block, data_stream + (i * SEGMENT_SIZE), SEGMENT_SIZE);
        sub_block[SEGMENT_SIZE] = '\0';
        unsigned long block_numeric = strtoul(sub_block, NULL, 2);
        running_total += block_numeric;

        while (running_total >> 8) {
            running_total = (running_total & 0xFF) + (running_total >> 8);
        }
    }

    return (unsigned char)(running_total & 0xFF);
}

void convert_byte_to_bitstring(unsigned char numeric_val, char *bit_string_out) {
    int i;
    for (i = 7; i >= 0; i--) {
        bit_string_out[7 - i] = (numeric_val & (1 << i)) ? '1' : '0';
    }
    bit_string_out[8] = '\0';
}

int main() {
    char input_data[500];
    char padded_data[500] = {0};
    char checksum_str[SEGMENT_SIZE + 1];
    char transmitted_frame[600] = {0};
    char received_frame[600] = {0};
    int error_indices[100];
    int num_errors = 0;

    int i, j;
    int input_len;
    int remainder;
    int total_len;
    int num_segments;
    unsigned char sum_val;
    unsigned char checksum_val;
    int frame_len;
    int receiver_segments;
    unsigned char receiver_sum;
    unsigned char verification_result;
    char rec_sum_str[9];
    char extracted_data[500] = {0};

    /* Simplified Input */
    printf("Enter binary data: ");
    scanf("%499s", input_data);

    input_len = strlen(input_data);
    strcpy(padded_data, input_data);

    remainder = input_len % SEGMENT_SIZE;

    if (remainder != 0) {
        int padding_needed = SEGMENT_SIZE - remainder;

        for (i = 0; i < padding_needed; i++) {
            strcat(padded_data, "0");
        }
    }

    total_len = strlen(padded_data);
    num_segments = total_len / SEGMENT_SIZE;

    /* Simplified Sender Display */
    printf("\n--- Sender Side ---\n");
    printf("Original Data: %s\n", input_data);
    printf("Padded Data:   %s\n", padded_data);

    for (i = 0; i < num_segments; i++) {
        printf("  Segment %d: ", i + 1);
        for (j = 0; j < SEGMENT_SIZE; j++) {
            printf("%c", padded_data[i * SEGMENT_SIZE + j]);
        }
        printf("\n");
    }

    sum_val = generate_block_checksum(padded_data, num_segments);
    checksum_val = (unsigned char)(~sum_val & 0xFF);
    convert_byte_to_bitstring(checksum_val, checksum_str);

    sprintf(transmitted_frame, "%s%s", padded_data, checksum_str);

    printf("Checksum Bits: %s\n", checksum_str);
    printf("Sent Data:     %s\n", transmitted_frame);

    strcpy(received_frame, transmitted_frame);
    frame_len = strlen(received_frame);

    /* Simplified Error Input */
    printf("\n--- Error Simulation ---\n");
    printf("Enter number of bits to flip: ");
    scanf("%d", &num_errors);

    if (num_errors > 0) {
        printf("Enter bit positions (0 to %d): ", frame_len - 1);

        for (i = 0; i < num_errors; i++) {
            scanf("%d", &error_indices[i]);

            if (error_indices[i] >= 0 && error_indices[i] < frame_len) {
                received_frame[error_indices[i]] =
                    (received_frame[error_indices[i]] == '0') ? '1' : '0';
            }
        }
        printf("Result: Flipped %d bits successfully.\n", num_errors);
    } else {
        printf("Result: No errors added.\n");
    }

    /* Simplified Receiver Display */
    printf("\n--- Receiver Side ---\n");
    printf("Received Data: %s\n", received_frame);

    receiver_segments = num_segments + 1;
    receiver_sum = generate_block_checksum(received_frame, receiver_segments);
    verification_result = (unsigned char)(~receiver_sum & 0xFF);
    convert_byte_to_bitstring(receiver_sum, rec_sum_str);

    printf("Receiver Sum:  %s\n", rec_sum_str);

    strncpy(extracted_data, received_frame, input_len);
    extracted_data[input_len] = '\0';

    /* Simplified Verdict */
    printf("\n--- Final Status ---\n");
    if (verification_result == 0) {
        printf("Result: PASS - No errors found.\n");
        printf("Output: %s\n", extracted_data);
    } else {
        printf("Result: FAIL - Error detected!\n");
        printf("Output: %s (Corrupted)\n", extracted_data);
    }

    return 0;
}
