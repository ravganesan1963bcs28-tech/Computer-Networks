/* Validates that a string contains only 0s and 1s */
int is_binary_string(const char *str) {
    int i;
    for (i = 0; str[i] != '\0'; i++) {
        if (str[i] != '0' && str[i] != '1') {
            return 0;
        }
    }
    return 1;
}

/* Programmatically enforces the three rules of a 'good generator' */
int check_good_generator(const char *gen) {
    int len = strlen(gen);
    int one_count = 0;
    int i;

    // Rule 1: Length must be more than 2 characters
    if (len <= 2) {
        printf("Error: Generator must be more than 2 characters long to be effective.\n");
        return 0;
    }

    // Rule 2: x^0 coefficient must be 1 (the final character must be '1')
    if (gen[len - 1] != '1') {
        printf("Error: The x^0 coefficient must be 1 (generator must end with a '1').\n");
        return 0;
    }

    // Rule 3: Must contain (x + 1) as a factor.
    // In modulo-2 polynomial math, if (x + 1) is a factor, substituting x = 1
    // must result in a remainder of 0. This means the generator must have an EVEN number of '1's.
    for (i = 0; i < len; i++) {
        if (gen[i] == '1') {
            one_count++;
        }
    }
    if (one_count % 2 != 0) {
        printf("Error: Generator does not contain (x + 1) as a factor (must have an even number of '1' bits).\n");
        return 0;
    }

    return 1;
}

void perform_crc_division(const char *input, const char *generator, char *remainder, int show_steps) {
    int input_len = strlen(input);
    int gen_len = strlen(generator);
    char *temp = (char *)malloc((input_len + 1) * sizeof(char));
    int i, j;

    strcpy(temp, input);

    if (show_steps) {
        printf("\n--- Step-by-Step XOR Division ---\n");
        printf("Initial Data: %s\n", temp);
    }

    for (i = 0; i <= input_len - gen_len; i++) {
        if (temp[i] == '1') {
            if (show_steps) {
                printf("Aligning:     ");
                for (j = 0; j < i; j++) printf(" ");
                printf("%s\n", generator);
            }

            for (j = 0; j < gen_len; j++) {
                temp[i + j] = (temp[i + j] == generator[j]) ? '0' : '1';
            }

            if (show_steps) {
                printf("Current XOR:  %s\n", temp);
            }
        }
    }

    strncpy(remainder, temp + (input_len - gen_len + 1), gen_len - 1);
    remainder[gen_len - 1] = '\0';

    free(temp);
}

