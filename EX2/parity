#include <stdio.h>
#include <string.h>
#include <stdlib.h>

/* Function prototypes */
int count_ones(const char *str);
void sender(const char *data, char *frame, int parity_mode);
void receiver(const char *frame, int parity_mode);

int main() {
    char data[100];
    char frame[102];
    int parity_mode = 1;
    int choice;
    int i; /* Declared out of the loop for compiler compatibility */

    printf("Enter binary data: ");
    scanf("%99s", data);

    /* Validate binary input */
    for (i = 0; data[i] != '\0'; i++) {
        if (data[i] != '0' && data[i] != '1') {
            printf("Error: Input data must only contain 0 and 1.\n");
            return 1;
        }
    }

    /* Select Parity Type */
    printf("\n--- Parity Selection ---\n");
    printf("1. Even Parity\n");
    printf("2. Odd Parity\n");
    printf("Select option (1/2): ");
    scanf("%d", &parity_mode);

    if (parity_mode != 1 && parity_mode != 2) {
        printf("Error: Invalid option chosen.\n");
        return 1;
    }

    /* 1. Sender Phase */
    sender(data, frame, parity_mode);

    /* 2. Channel Simulation Phase */
    printf("\n--- Error Simulation ---\n");
    printf("1. No errors\n");
    printf("2. Flip 1 bit\n");
    printf("Select option (1/2): ");
    scanf("%d", &choice);

    if (choice == 2) {
        frame[0] = (frame[0] == '0') ? '1' : '0';
        printf("Result: Flipped 1 bit at index 0.\n");
    } else {
        printf("Result: No errors added.\n");
    }

    /* 3. Receiver Phase */
    receiver(frame, parity_mode);

    return 0;
}

/* Counts the number of '1's in a string */
int count_ones(const char *str) {
    int count = 0;
    while (*str) {
        if (*str == '1') {
            count++;
        }
        str++;
    }
    return count;
}

/* Appends parity bit based on selected mode */
void sender(const char *data, char *frame, int parity_mode) {
    int ones = count_ones(data);
    char parity_bit;
    int len;

    if (parity_mode == 1) {
        parity_bit = (ones % 2 == 0) ? '0' : '1';
    } else {
        parity_bit = (ones % 2 == 0) ? '1' : '0';
    }

    strcpy(frame, data);
    len = strlen(frame);
    frame[len] = parity_bit;
    frame[len + 1] = '\0';

    printf("\n--- Sender Side ---\n");
    printf("Original Data: %s\n", data);
    printf("Parity Mode:   %s\n", (parity_mode == 1) ? "EVEN" : "ODD");
    printf("Parity Bit:    %c\n", parity_bit);
    printf("Sent Data:     %s\n", frame);
}

/* Checks the frame against selected parity mode */
void receiver(const char *frame, int parity_mode) {
    int len = strlen(frame);
    int total_ones = count_ones(frame);
    int is_valid = 0;
    char extracted_data[100];

    printf("\n--- Receiver Side ---\n");
    printf("Received Data: %s\n", frame);

    if (parity_mode == 1) {
        is_valid = (total_ones % 2 == 0);
    } else {
        is_valid = (total_ones % 2 != 0);
    }

    printf("\n--- Final Status ---\n");
    if (is_valid) {
        printf("Result: PASS - No errors found.\n");
        strncpy(extracted_data, frame, len - 1);
        extracted_data[len - 1] = '\0';
        printf("Output: %s\n", extracted_data);
    } else {
        printf("Result: FAIL - Error detected!\n");
    }
}
