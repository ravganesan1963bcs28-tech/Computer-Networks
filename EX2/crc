#include <stdio.h>
#include <string.h>
#include <stdlib.h>

void perform_crc_division(const char *input, const char *generator, char *remainder) {
    int input_len = strlen(input);
    int gen_len = strlen(generator);

    char *temp = (char *)malloc((input_len + 1) * sizeof(char));
    strcpy(temp, input);

    for (int i = 0; i <= input_len - gen_len; i++) {
        if (temp[i] == '1') {
            for (int j = 0; j < gen_len; j++) {
                temp[i + j] =
                    (temp[i + j] == generator[j]) ? '0' : '1';
            }
        }
    }

    strncpy(remainder,
            temp + (input_len - gen_len + 1),
            gen_len - 1);

    remainder[gen_len - 1] = '\0';

    free(temp);
}

int main() {
    char data[500], generator[100];
    char augmented_data[600] = {0};
    char remainder[100];
    char transmitted_cw[600];
    char received_cw[600];

    int num_errors, error_pos;

    printf("=== CRC Error Detection Lab Simulation ===\n");

    printf("Enter binary data bitstream (e.g., 1001): ");
    scanf("%499s", data);

    printf("Enter generator polynomial bits (e.g., 1011): ");
    scanf("%99s", generator);

    int gen_len = strlen(generator);

    // --- SENDER SIDE ---
    strcpy(augmented_data, data);

    for (int i = 0; i < gen_len - 1; i++) {
        strcat(augmented_data, "0");
    }

    perform_crc_division(augmented_data, generator, remainder);

    strcpy(transmitted_cw, data);
    strcat(transmitted_cw, remainder);

    printf("\n--- Sender Side ---\n");
    printf("Original Data:        %s\n", data);
    printf("Generator Polynomial: %s\n", generator);
    printf("Calculated Remainder: %s\n", remainder);
    printf("Transmitted Codeword: %s\n", transmitted_cw);

    // --- CHANNEL SIMULATION ---
    strcpy(received_cw, transmitted_cw);

    int cw_len = strlen(received_cw);

    printf("\n--- Transmission Error Simulation ---\n");
    printf("How many bits do you want to corrupt/flip? (Enter 0, 1, or more): ");
    scanf("%d", &num_errors);

    if (num_errors > 0) {
        printf("Enter the 0-indexed positions (from 0 to %d) to flip: ",
               cw_len - 1);

        for (int i = 0; i < num_errors; i++) {
            scanf("%d", &error_pos);

            if (error_pos >= 0 && error_pos < cw_len) {
                received_cw[error_pos] =
                    (received_cw[error_pos] == '0') ? '1' : '0';
            }
        }

        printf("[Channel] Injected %d error bit(s) into the stream.\n",
               num_errors);
    } else {
        printf("[Channel] Transmitting perfectly with no channel errors.\n");
    }

    // --- RECEIVER SIDE ---
    char receiver_remainder[100];

    perform_crc_division(received_cw,
                         generator,
                         receiver_remainder);

    int is_error = 0;

    for (int i = 0; i < gen_len - 1; i++) {
        if (receiver_remainder[i] == '1') {
            is_error = 1;
            break;
        }
    }

    // Extract original data portion
    char extracted_data[500] = {0};

    strncpy(extracted_data,
            received_cw,
            strlen(data));

    extracted_data[strlen(data)] = '\0';

    printf("\n--- Receiver Side ---\n");
    printf("Received Codeword:    %s\n", received_cw);
    printf("Receiver Remainder:   %s\n", receiver_remainder);

    printf("\n========================================\n");
    printf("FINAL ERROR DETECTION STATUS:\n");

    if (is_error) {
        printf(">>> STATUS: FAIL - Transmission is CORRUPTED!\n");
        printf(">>> Reason: Receiver remainder is non-zero (%s).\n",
               receiver_remainder);
        printf(">>> Extracted Original Data:   %s (CORRUPTED)\n",
               extracted_data);
    } else {
        printf(">>> STATUS: PASS - Transmission is SUCCESSFUL / ERROR FREE!\n");
        printf(">>> Reason: Receiver remainder is perfectly zero.\n");
        printf(">>> Extracted Original Data:   %s\n",
               extracted_data);
    }

    printf("========================================\n");

    return 0;
}
