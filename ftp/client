
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 8080
#define BUFFER_SIZE 4096
#define SERVER_IP "127.0.0.1"

void displayMenu() {
    printf("\n============= FTP CLIENT =============\n");
    printf("   1.  Upload a file\n");
    printf("   2.  Download a file\n");
