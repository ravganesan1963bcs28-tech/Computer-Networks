    printf("   5.  List files\n");
    printf("   6.  Create directory\n");
    printf("   7.  Remove directory\n");
    printf("   8.  Change directory\n");
    printf("   9.  Print working directory\n");
    printf("  10.  File size\n");
    printf("  11.  Search file\n");
    printf("  12.  Quit\n");
    printf("======================================\n");
}

void uploadFile(int sockfd) {
    char buffer[BUFFER_SIZE];
    char filename[256];
    FILE *fp;
    int n;

    printf("Enter filename to upload: ");
    scanf("%s", filename);
    getchar();

    fp = fopen(filename, "r");
    if (fp == NULL) {
        printf("ERROR: File '%s' not found locally.\n", filename);
        return;
    }

    sprintf(buffer, "UPLOAD %s", filename);
    send(sockfd, buffer, strlen(buffer), 0);

    n = recv(sockfd, buffer, BUFFER_SIZE, 0);
    buffer[n] = '\0';

    if (strcmp(buffer, "READY") != 0) {
        printf("Server: %s\n", buffer);
        fclose(fp);
        return;
    }

    while (fgets(buffer, BUFFER_SIZE, fp) != NULL) {
        send(sockfd, buffer, strlen(buffer), 0);
        usleep(50000);
    }
    fclose(fp);
    usleep(100000);
    send(sockfd, "EOF", 3, 0);

    n = recv(sockfd, buffer, BUFFER_SIZE, 0);
    buffer[n] = '\0';
    printf("\n>>> %s\n", buffer);
}

void downloadFile(int sockfd) {
    char buffer[BUFFER_SIZE];
    char filename[256];
    FILE *fp;
    int n;

    printf("Enter filename to download: ");
    scanf("%s", filename);
    getchar();

    sprintf(buffer, "DOWNLOAD %s", filename);
    send(sockfd, buffer, strlen(buffer), 0);

    n = recv(sockfd, buffer, BUFFER_SIZE, 0);
    buffer[n] = '\0';

    if (strcmp(buffer, "READY") != 0) {
        printf("Server: %s\n", buffer);
        return;
    }

    fp = fopen(filename, "w");
    if (fp == NULL) {
        printf("ERROR: Cannot create file locally.\n");
        return;
    }

    while (1) {
        n = recv(sockfd, buffer, BUFFER_SIZE, 0);
        if (n <= 0)
            break;
        buffer[n] = '\0';
        if (strcmp(buffer, "EOF") == 0)
            break;
        fprintf(fp, "%s", buffer);
    }
    fclose(fp);
    printf("\n>>> File '%s' downloaded successfully!\n", filename);
}

