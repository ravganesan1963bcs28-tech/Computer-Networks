#include <stdio.h>

#define MAX 10
#define INF 999


/* =================================================
   FUNCTION 1: DISPLAY COST MATRIX
   ================================================= */

void displayMatrix(int n, int graph[MAX][MAX])
{
    int i, j;

    printf("\n============================================\n");
    printf("                COST MATRIX\n");
    printf("============================================\n\n");

    printf("\t");

    for (i = 0; i < n; i++)
        printf("R%d\t", i + 1);

    printf("\n");

    for (i = 0; i < n; i++)
    {
        printf("R%d\t", i + 1);

        for (j = 0; j < n; j++)
        {
            if (graph[i][j] == INF)
                printf("INF\t");
            else
                printf("%d\t", graph[i][j]);
        }

        printf("\n");
    }
}


/* =================================================
   FUNCTION 2: DISTANCE VECTOR ROUTING
   ================================================= */

void distanceVector(int n, int cost[MAX][MAX])
{
    int distance[MAX][MAX];
    int nextHop[MAX][MAX];

    int i, j, k;
    int updated;
    int iteration = 0;

    /* Initialize routing table */

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            distance[i][j] = cost[i][j];

            if (cost[i][j] != INF && i != j)
                nextHop[i][j] = j;
            else
                nextHop[i][j] = -1;
        }
    }


    /* Distance Vector calculation */

    do
    {
        updated = 0;
        iteration++;

        for (i = 0; i < n; i++)
        {
            for (j = 0; j < n; j++)
            {
                for (k = 0; k < n; k++)
                {
                    if (distance[i][k] != INF &&
                        distance[k][j] != INF)
                    {
                        if (distance[i][k] +
                            distance[k][j] <
                            distance[i][j])
                        {
                            distance[i][j] =
                                distance[i][k] +
                                distance[k][j];

                            nextHop[i][j] =
                                nextHop[i][k];

                            updated = 1;
                        }
                    }
                }
            }
        }

    } while (updated);


    /* Display result */

    printf("\n============================================\n");
    printf("          DISTANCE VECTOR ROUTING\n");
    printf("============================================\n");

    printf("\nNumber of iterations: %d\n", iteration);

    for (i = 0; i < n; i++)
    {
        printf("\n------------ ROUTER R%d ------------\n", i + 1);

        printf("Destination\tNext Hop\tDistance\n");
        printf("--------------------------------------------\n");

        for (j = 0; j < n; j++)
        {
            printf("R%d\t\t", j + 1);

            if (i == j)
            {
                printf("-\t\t0\n");
            }
            else if (distance[i][j] == INF)
            {
                printf("-\t\tINF\n");
            }
            else
            {
                printf("R%d\t\t%d\n",
                       nextHop[i][j] + 1,
                       distance[i][j]);
            }
        }
    }
}


/* =================================================
   FUNCTION 3: FIND MINIMUM DISTANCE
   ================================================= */

int findMinimum(int distance[MAX],
                int visited[MAX],
                int n)
{
    int min = INF;
    int index = -1;

    int i;

    for (i = 0; i < n; i++)
    {
        if (!visited[i] &&
            distance[i] < min)
        {
            min = distance[i];
            index = i;
        }
    }

    return index;
}


/* =================================================
   FUNCTION 4: DISPLAY PATH
   ================================================= */

void displayPath(int parent[MAX],
                 int destination)
{
    if (parent[destination] == -1)
    {
        printf("R%d", destination + 1);
        return;
    }

    displayPath(parent, parent[destination]);

    printf(" -> R%d", destination + 1);
}


/* =================================================
   FUNCTION 5: LINK STATE ROUTING
   USING DIJKSTRA'S ALGORITHM
   ================================================= */

void linkState(int n, int graph[MAX][MAX])
{
    int distance[MAX];
    int visited[MAX];
    int parent[MAX];

    int source;
    int i, count;
    int current;

    printf("\nEnter source router (e.g., 1): ");
    scanf("%d", &source);

    if (source < 1 || source > n)
    {
        printf("\nInvalid source router!\n");
        return;
    }

    source--;


    /* Initialization */

    for (i = 0; i < n; i++)
    {
        distance[i] = INF;
        visited[i] = 0;
        parent[i] = -1;
    }

    distance[source] = 0;


    /* Dijkstra Algorithm */

    for (count = 0; count < n - 1; count++)
    {
        current =
            findMinimum(distance,
                        visited,
                        n);

        if (current == -1)
            break;

        visited[current] = 1;

        for (i = 0; i < n; i++)
        {
            if (!visited[i] &&
                graph[current][i] != INF &&
                distance[current] != INF)
            {
                int newDistance =
                    distance[current] +
                    graph[current][i];

                if (newDistance < distance[i])
                {
                    distance[i] = newDistance;
                    parent[i] = current;
                }
            }
        }
    }


    /* Display result */

    printf("\n============================================\n");
    printf("             LINK STATE ROUTING\n");
    printf("============================================\n");

    printf("\nSource Router: R%d\n", source + 1);

    printf("\nDestination\tCost\tShortest Path\n");
    printf("--------------------------------------------\n");

    for (i = 0; i < n; i++)
    {
        printf("R%d\t\t", i + 1);

        if (distance[i] == INF)
        {
            printf("INF\tNo Path\n");
        }
        else
        {
            printf("%d\t", distance[i]);

            displayPath(parent, i);

            printf("\n");
        }
    }
}


/* =================================================
   MAIN FUNCTION
   ================================================= */

int main()
{
    int n;
    int graph[MAX][MAX];

    int i, j;
    int choice;

    printf("\n============================================\n");
    printf("       ROUTING ALGORITHM SIMULATOR\n");
    printf("============================================\n");

    printf("\nSelect Routing Algorithm:\n");
    printf("--------------------------------------------\n");
    printf("1. Distance Vector Routing\n");
    printf("2. Link State Routing\n");
    printf("3. Run Both Algorithms\n");
    printf("4. Exit\n");

    printf("\nEnter your choice (e.g., 1): ");
    scanf("%d", &choice);


    /* Exit */

    if (choice == 4)
    {
        printf("\nProgram terminated.\n");
        return 0;
    }


    /* Validate choice */

    if (choice < 1 || choice > 4)
    {
        printf("\nInvalid choice!\n");
        return 0;
    }


    /* Number of routers */

    printf("\nEnter number of routers (e.g., 4, maximum %d): ",
           MAX);

    scanf("%d", &n);

    if (n <= 0 || n > MAX)
    {
        printf("\nInvalid number of routers!\n");
        return 0;
    }


    /* Cost Matrix */

    printf("\n============================================\n");
    printf("              ENTER COST MATRIX\n");
    printf("============================================\n");

    printf("\nEnter the cost of each link.\n");
    printf("Enter %d if there is NO direct connection.\n", INF);
    printf("Cost from a router to itself will be 0.\n\n");


    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            if (i == j)
            {
                graph[i][j] = 0;
                continue;
            }

            printf("Cost R%d -> R%d (e.g., 2 or %d): ",
                   i + 1,
                   j + 1,
                   INF);

            scanf("%d", &graph[i][j]);
        }
    }


    /* Display network */

    displayMatrix(n, graph);


    /* Select algorithm */

    switch (choice)
    {
        case 1:

            printf("\n\n******** RUNNING DISTANCE VECTOR ********\n");

            distanceVector(n, graph);

            break;


        case 2:

            printf("\n\n******** RUNNING LINK STATE ********\n");

            linkState(n, graph);

            break;


        case 3:

            printf("\n\n******** RUNNING DISTANCE VECTOR ********\n");

            distanceVector(n, graph);

            printf("\n\n******** RUNNING LINK STATE ********\n");

            linkState(n, graph);

            break;
    }


    printf("\n============================================\n");
    printf("             PROGRAM COMPLETED\n");
    printf("============================================\n");

    return 0;
}
