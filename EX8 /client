
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 8053
#define BUFFER_SIZE 4096
#define SERVER_IP "127.0.0.1"

void displayMenu() {
    printf("\n============= DNS CLIENT =============\n");
    printf("  1. Forward Lookup  (Domain -> IP)\n");
    printf("  2. Reverse Lookup  (IP -> Domain)\n");
    printf("  3. Add DNS Record\n");
    printf("  4. Delete DNS Record\n");
    printf("  5. List All DNS Records\n");
    printf("  6. Quit\n");
    printf("======================================\n");
}

int main() {
    int sockfd;
    char buffer[BUFFER_SIZE], message[BUFFER_SIZE];
    struct sockaddr_in server_addr;
    socklen_t addr_len = sizeof(server_addr);
    int choice, n;
    char domain[256], ip[50];

    if ((sockfd = socket(AF_INET, SOCK_DGRAM, 0)) < 0) {
        perror("Socket creation failed");
        exit(EXIT_FAILURE);
    }

    memset(&server_addr, 0, sizeof(server_addr));

    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    inet_pton(AF_INET, SERVER_IP, &server_addr.sin_addr);

    printf("==========================================\n");
    printf("        DNS Client (UDP)\n");
    printf("==========================================\n");
    printf("Connected to DNS server at %s:%d\n", SERVER_IP, PORT);

    while (1) {
        displayMenu();

        printf("\nEnter your choice: ");
        scanf("%d", &choice);
        getchar();

        switch (choice) {
            case 1:
                printf("Enter domain name: ");
                scanf("%s", domain);
                getchar();
                sprintf(message, "FORWARD %s", domain);
                break;

            case 2:
                printf("Enter IP address: ");
                scanf("%s", ip);
                getchar();
                sprintf(message, "REVERSE %s", ip);
                break;

            case 3:
                printf("Enter domain name: ");
                scanf("%s", domain);
                getchar();
                printf("Enter IP address: ");
                scanf("%s", ip);
                getchar();
                sprintf(message, "ADD %s %s", domain, ip);
                break;

            case 4:
                printf("Enter domain name to delete: ");
                scanf("%s", domain);
                getchar();
                sprintf(message, "DELETE %s", domain);
                break;

            case 5:
                sprintf(message, "LIST");
                break;

            case 6:
                sprintf(message, "QUIT");
                sendto(sockfd, message, strlen(message), 0,
                       (const struct sockaddr *)&server_addr, addr_len);
                n = recvfrom(sockfd, buffer, BUFFER_SIZE, 0,
                             (struct sockaddr *)&server_addr, &addr_len);
                buffer[n] = '\0';
                printf("\n>>> %s\n", buffer);
                printf("==========================================\n");
                close(sockfd);
                return 0;

            default:
                printf("Invalid choice! Try again.\n");
                continue;
        }

        sendto(sockfd, message, strlen(message), 0,
               (const struct sockaddr *)&server_addr, addr_len);

        n = recvfrom(sockfd, buffer, BUFFER_SIZE, 0,
                     (struct sockaddr *)&server_addr, &addr_len);
        buffer[n] = '\0';
        printf("\n>>> %s\n", buffer);
    }

    close(sockfd);
    return 0;
}

