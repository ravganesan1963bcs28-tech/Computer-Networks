
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <signal.h>
#include <sys/wait.h>

#define PORT 8080
#define BUFFER_SIZE 1024
#define SERVER_IP "127.0.0.1"

int main() {
    int sockfd;
    char buffer[BUFFER_SIZE];
    char name[50], server_name[50];
    struct sockaddr_in server_addr;
    pid_t pid;
    int n;

    if ((sockfd = socket(AF_INET, SOCK_STREAM, 0)) < 0) {
        perror("Socket creation failed");
        exit(EXIT_FAILURE);
    }

    memset(&server_addr, 0, sizeof(server_addr));

    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    inet_pton(AF_INET, SERVER_IP, &server_addr.sin_addr);

    printf("=============================\n");
    printf("  TCP Full-Duplex Chat\n");
    printf("=============================\n\n");

    printf("Enter your name: ");
    fgets(name, 50, stdin);
    name[strcspn(name, "\n")] = '\0';

    printf("Connecting to server...\n");

    if (connect(sockfd, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("Connection failed");
        close(sockfd);
        exit(EXIT_FAILURE);
    }

    send(sockfd, name, strlen(name), 0);

    n = recv(sockfd, server_name, 50, 0);
    server_name[n] = '\0';

    printf("Connected with %s!\n", server_name);
    printf("Type 'exit' to end the chat.\n");
    printf("-----------------------------\n\n");

    pid = fork();

    if (pid == 0) {
        while (1) {
            n = recv(sockfd, buffer, BUFFER_SIZE, 0);
            if (n <= 0) {
                printf("\n%s disconnected.\n", server_name);
                kill(getppid(), SIGTERM);
                break;
            }
            buffer[n] = '\0';

            if (strcmp(buffer, "exit") == 0) {
                printf("\n%s left the chat.\n", server_name);
                kill(getppid(), SIGTERM);
                break;
            }

            printf("\n%s: %s\n", server_name, buffer);
            printf("You: ");
            fflush(stdout);
        }
        exit(0);
    }
    else {
        while (1) {
            printf("You: ");
            fgets(buffer, BUFFER_SIZE, stdin);
            buffer[strcspn(buffer, "\n")] = '\0';

            send(sockfd, buffer, strlen(buffer), 0);

            if (strcmp(buffer, "exit") == 0) {
                printf("\nYou left the chat.\n");
                kill(pid, SIGTERM);
                break;
            }
        }
        wait(NULL);
    }

    printf("-----------------------------\n");
    printf("Chat ended.\n");
    close(sockfd);
    return 0;
}

