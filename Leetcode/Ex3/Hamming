#include <stdio.h>

int hammingDistance(int x, int y)
{
    int xor = x ^ y;
    int count = 0;

    while (xor != 0)
    {
        count += xor & 1;
        xor >>= 1;
    }

    return count;
}

int main()
{
    int x, y, result;

    printf("========== HAMMING DISTANCE ==========\n");

    printf("\nEnter first number (e.g., 1): ");
    scanf("%d", &x);

    printf("Enter second number (e.g., 4): ");
    scanf("%d", &y);

    result = hammingDistance(x, y);

    printf("\nHamming Distance between %d and %d = %d\n",
           x, y, result);

    return 0;
}
