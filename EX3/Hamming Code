#include <stdio.h>
#include <string.h>

int main() {
    char data[50], correctedData[50];
    int code[50], received[50];
    int dataLen, r = 0, codeLen;
    int i, j, pos, choice, errorPos;

    printf("\n========== HAMMING CODE ==========\n");

    /* INPUT */
    printf("\nEnter data bits (e.g., 1011): ");
    scanf("%s", data);

    dataLen = strlen(data);

    /* Find number of parity bits */
    while ((1 << r) < dataLen + r + 1)
        r++;

    codeLen = dataLen + r;

    /* Place data bits and parity positions */
    j = 0;

    for (i = 1; i <= codeLen; i++) {
        if ((i & (i - 1)) == 0)
            code[i] = -1;
        else
            code[i] = data[j++] - '0';
    }

    /* Calculate parity bits */
    for (i = 0; i < r; i++) {

        pos = 1 << i;
        int count = 0;

        for (j = pos; j <= codeLen; j++) {

            if (((j / pos) % 2) == 1 && code[j] == 1)
                count++;
        }

        code[pos] = count % 2;
    }

    /* SENDER */
    printf("\n------------- SENDER -------------\n");

    printf("Data bits        : %s\n", data);
    printf("Number of parity : %d\n", r);

    printf("\nHamming Code Format:\n");

    int dataNumber = 1;

    for (i = 1; i <= codeLen; i++) {

        if ((i & (i - 1)) == 0)
            printf("P%d ", i);
        else {
            printf("D%d ", dataNumber);
            dataNumber++;
        }
    }

    printf("\n");

    printf("Position         : ");

    for (i = 1; i <= codeLen; i++)
        printf("%2d ", i);

    printf("\n");

    printf("Codeword         : ");

    for (i = 1; i <= codeLen; i++)
        printf("%2d ", code[i]);

    printf("\n");

    /* Copy codeword */
    for (i = 1; i <= codeLen; i++)
        received[i] = code[i];

    /* ERROR INPUT */
    printf("\nDo you want to introduce an error? (1 = Yes, 0 = No): ");
    scanf("%d", &choice);

    if (choice == 1) {

        printf("Enter error position (e.g., 5): ");
        scanf("%d", &errorPos);

        if (errorPos >= 1 && errorPos <= codeLen) {

            received[errorPos] = !received[errorPos];

            printf("Error introduced at position %d.\n", errorPos);

        } else {

            printf("Invalid position!\n");
            return 0;
        }
    }

    /* RECEIVER */
    printf("\n------------ RECEIVER ------------\n");

    printf("Received Codeword: ");

    for (i = 1; i <= codeLen; i++)
        printf("%d ", received[i]);

    printf("\n");

    /* SYNDROME */
    int syndrome = 0;

    printf("\nParity Checks:\n");

    for (i = 0; i < r; i++) {

        pos = 1 << i;
        int count = 0;

        for (j = pos; j <= codeLen; j++) {

            if (((j / pos) % 2) == 1 && received[j] == 1)
                count++;
        }

        printf("P%d check = %d\n", pos, count % 2);

        if (count % 2)
            syndrome += pos;
    }

    printf("\nSyndrome = %d\n", syndrome);

    /* ERROR DETECTION */
    if (syndrome == 0) {

        printf("Status   : No error detected.\n");

    } else {

        printf("Status   : Error detected!\n");
        printf("Error at : Position %d\n", syndrome);

        /* Correct error */
        received[syndrome] = !received[syndrome];

        printf("Corrected Codeword: ");

        for (i = 1; i <= codeLen; i++)
            printf("%d ", received[i]);

        printf("\n");
    }

    /* EXTRACT DATA */
    j = 0;

    for (i = 1; i <= codeLen; i++) {

        if ((i & (i - 1)) != 0)
            correctedData[j++] = received[i] + '0';
    }

    correctedData[j] = '\0';

    printf("\nRecovered Data: %s\n", correctedData);

    printf("\n===================================\n");

    return 0;
}

