#include <stdio.h>
#include <stdlib.h>

void sender(int data[], int code[]);
void receiver(int received_code[]);

int main() {
    int i;
    int data[7];
    int code[11];
    int received_code[11];
    int choice;

    printf("Enter 7 data bits (0 or 1) one by one:\n");
    for (i = 0; i < 7; i++) {
        printf("Bit %d: ", 7 - i);
        if (scanf("%d", &data[i]) != 1) {
            return 1;
        }
        if (data[i] != 0 && data[i] != 1) {
            printf("Error: Input must be 0 or 1.\n");
            return 1;
        }
    }

    sender(data, code);

    printf("\nGenerated Hamming Code (11 bits): ");
    for (i = 0; i < 11; i++) {
        printf("%d ", code[i]);
    }
    printf("\n");

    for (i = 0; i < 11; i++) {
        received_code[i] = code[i];
    }

    printf("\nSimulate transmission error?\n1. Yes\n2. No\nChoice: ");
    if (scanf("%d", &choice) != 1) {
        return 1;
    }

    if (choice == 1) {
        int error_pos;
        printf("Enter bit position to flip (1 to 11 from right): ");
        if (scanf("%d", &error_pos) != 1) {
            return 1;
        }
        if (error_pos >= 1 && error_pos <= 11) {
            received_code[11 - error_pos] = !received_code[11 - error_pos];
            printf("Bit %d flipped successfully!\n", error_pos);
        } else {
            printf("Invalid position. No error injected.\n");
        }
    }

    printf("\nReceived Code at Destination: ");
    for (i = 0; i < 11; i++) {
        printf("%d ", received_code[i]);
    }
    printf("\n");

    receiver(received_code);

    return 0;
}

void sender(int data[], int code[]) {
    /* Mapping data to 11-bit array positions (0-indexed left-to-right) */
    code[0] = data[0]; /* D7 -> pos 11 */
    code[1] = data[1]; /* D6 -> pos 10 */
    code[2] = data[2]; /* D5 -> pos 9  */
    code[4] = data[3]; /* D4 -> pos 7  */
    code[5] = data[4]; /* D3 -> pos 6  */
    code[6] = data[5]; /* D2 -> pos 5  */
    code[8] = data[6]; /* D1 -> pos 3  */

    /* Parity Bit Calculations using Even Parity XOR */
    code[10] = code[8] ^ code[6] ^ code[4] ^ code[2] ^ code[0]; /* P1 (1,3,5,7,9,11) */
    code[9]  = code[8] ^ code[5] ^ code[4] ^ code[1] ^ code[0]; /* P2 (2,3,6,7,10,11) */
    code[7]  = code[6] ^ code[5] ^ code[4];                     /* P3 (4,5,6,7)       */
    code[3]  = code[2] ^ code[1] ^ code[0];                     /* P4 (8,9,10,11)     */
}

void receiver(int received_code[]) {
    int c1, c2, c3, c4, error_pos;
    int i;

    /* Compute Syndrome Bits */
    c1 = received_code[10] ^ received_code[8] ^ received_code[6] ^ received_code[4] ^ received_code[2] ^ received_code[0];
    c2 = received_code[9]  ^ received_code[8] ^ received_code[5] ^ received_code[4] ^ received_code[1] ^ received_code[0];
    c3 = received_code[7]  ^ received_code[6] ^ received_code[5] ^ received_code[4];
    c4 = received_code[3]  ^ received_code[2] ^ received_code[1] ^ received_code[0];

    /* Calculate base 10 position of the corrupted bit */
    error_pos = (c4 * 8) + (c3 * 4) + (c2 * 2) + (c1 * 1);

    if (error_pos != 0) {
        printf("\nError detected at bit position: %d (from right)\n", error_pos);
        received_code[11 - error_pos] = !received_code[11 - error_pos];

        printf("Corrected Hamming Code: ");
        for (i = 0; i < 11; i++) {
            printf("%d ", received_code[i]);
        }
        printf("\n");
    } else {
        printf("\nNo error detected (Syndrome = 0).\n");
    }

    printf("Extracted Original Data: %d %d %d %d %d %d %d\n",
           received_code[0], received_code[1], received_code[2],
           received_code[4], received_code[5], received_code[6],
           received_code[8]);
}
