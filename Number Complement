#include <stdio.h>
int findComplement(int num) {
    unsigned int mask = 1;
    while (mask < num) {
        mask = (mask << 1) | 1;
    }
    return num ^ mask;
}
int main() {
    int test1 = 5;
    int test2 = 1;
    printf("Input: %d -> Complement: %d\n", test1, findComplement(test1));
    printf("Input: %d -> Complement: %d\n", test2, findComplement(test2));
    return 0;
}
