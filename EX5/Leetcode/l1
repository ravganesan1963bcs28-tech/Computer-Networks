#include <stdlib.h>

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* maxSlidingWindow(int* nums, int numsSize, int k, int* returnSize) {
    if (numsSize == 0 || k == 0) {
        *returnSize = 0;
        return NULL;
    }

    // There will be exactly (numsSize - k + 1) windows
    *returnSize = numsSize - k + 1;
    int* result = (int*)malloc((*returnSize) * sizeof(int));
    
    // Deque stores indices of elements
    int* deque = (int*)malloc(numsSize * sizeof(int));
    int head = 0; // Front of the deque
    int tail = 0; // Back of the deque

    for (int i = 0; i < numsSize; i++) {
        // 1. Remove indices that are out of the current window boundaries
        if (head < tail && deque[head] < i - k + 1) {
            head++;
        }

        // 2. Maintain monotonic property: remove elements smaller than the current element
        // from the back of the deque because they can never be the maximum
        while (head < tail && nums[deque[tail - 1]] <= nums[i]) {
            tail--;
        }

        // 3. Insert the current element's index at the back of the deque
        deque[tail++] = i;

        // 4. Once the window reaches size k, the front of the deque is the maximum
        if (i >= k - 1) {
            result[i - k + 1] = nums[deque[head]];
        }
    }

    // Free the auxiliary deque memory
    free(deque);
    
    return result;
}
