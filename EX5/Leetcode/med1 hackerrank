#include <stdio.h>
#include <stdlib.h>
#include <string.h>

long long max_val(long long a, long long b) {
    return (a > b) ? a : b;
}

long* riddle(long* arr, int arr_count, int* result_count) {
    int n = arr_count;
    *result_count = n;

    int* left = (int*)malloc(n * sizeof(int));
    int* right = (int*)malloc(n * sizeof(int));
    int* stack = (int*)malloc(n * sizeof(int));
    int top = -1;

    for (int i = 0; i < n; i++) {
        left[i] = -1;
        right[i] = n;
    }

    for (int i = 0; i < n; i++) {
        while (top >= 0 && arr[stack[top]] >= arr[i]) {
            top--;
        }
        if (top >= 0) {
            left[i] = stack[top];
        }
        stack[++top] = i;
    }

    top = -1;
    for (int i = n - 1; i >= 0; i--) {
        while (top >= 0 && arr[stack[top]] >= arr[i]) {
            top--;
        }
        if (top >= 0) {
            right[i] = stack[top];
        }
        stack[++top] = i;
    }

    long* ans = (long*)calloc((n + 1), sizeof(long));

    for (int i = 0; i < n; i++) {
        int len = right[i] - left[i] - 1;
        ans[len] = max_val(ans[len], arr[i]);
    }

    for (int i = n - 1; i >= 1; i--) {
        ans[i] = max_val(ans[i], ans[i + 1]);
    }

    long* res = (long*)malloc(n * sizeof(long));
    for (int i = 1; i <= n; i++) {
        res[i - 1] = ans[i];
    }

    free(left);
    free(right);
    free(stack);
    free(ans);

    return res;
}

int main() {
    FILE* fout = fopen(getenv("OUTPUT_PATH"), "w");

    int n;
    if (scanf("%d", &n) != 1) return 0;

    long* arr = (long*)malloc(n * sizeof(long));
    for (int i = 0; i < n; i++) {
        if (scanf("%ld", &arr[i]) != 1) return 0;
    }

    int res_count;
    long* res = riddle(arr, n, &res_count);

    for (int i = 0; i < res_count; i++) {
        fprintf(fout, "%ld", res[i]);
        if (i != res_count - 1) {
            fprintf(fout, " ");
        }
    }
    fprintf(fout, "\n");

    fclose(fout);
    free(arr);
    free(res);

    return 0;
}
