#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#define MAX_STR   100
#define MAX_BITS  1000
#define MAX_BYTES 500

/* ==========================================
   EMBEDDED OPTIMISED CONVERSION UTILITIES
   ========================================== */
void ascii_to_bin(char ascii, char *bin_str) {
    int i;
    for (i = 0; i < 8; i++) bin_str[i] = ((ascii >> (7 - i)) & 1) ? '1' : '0';
    bin_str[8] = '\0';
}

char bin_to_ascii(const char *bin_str) {
    char ascii = 0;
    int i;
    for (i = 0; i < 8; i++) ascii = (ascii << 1) | (bin_str[i] - '0');
    return ascii;
}

void str_to_ascii(const char *str, int *ascii_arr, int *len) {
    for (*len = 0; str[*len]; (*len)++) ascii_arr[*len] = str[*len];
}

void ascii_to_str(const int *ascii_arr, int len, char *str) {
    int i;
    for (i = 0; i < len; i++) str[i] = ascii_arr[i];
    str[len] = '\0';
}

/* Global Buffers */
int data[MAX_BITS], stuffed[MAX_BITS], destuffed[MAX_BITS];
int dataBytes[MAX_BYTES], stuffedBytes[MAX_BYTES], framedBytes[MAX_BYTES], destuffedBytes[MAX_BYTES];
int flag[] = {0,1,1,1,1,1,1,0};
int flagLen = 8, flagByte, escByte;

/* ==========================================
   PRINT UTILITIES
   ========================================== */
void printBits(const char *label, int arr[], int n) {
    int i;
    printf("%s", label);
    for (i = 0; i < n; i++) printf("%d", arr[i]);
    printf("\n");
}

void printByteArray(int byte) {
    int i;
    for (i = 7; i >= 0; i--) printf("%d", (byte >> i) & 1);
}

void printBytesAsBinary(const char *label, int arr[], int n) {
    int i;
    printf("%s", label);
    for (i = 0; i < n; i++) printByteArray(arr[i]);
    printf("\n");
}

/* ==========================================
   METHOD 1: BIT STUFFING COMPONENT (unchanged)
   ========================================== */
void bitStuffing() {
    char inputString[MAX_STR], bin_str[9], outputString[MAX_STR];
    int ascii_arr[MAX_STR], framed[MAX_BITS], originalFramedBackup[MAX_BITS], out_ascii_arr[MAX_STR];
    int str_len = 0, n = 0, ones = 0, j = 0, k = 0, framedLen = 0, stuffedLen = 0, destuffedLen = 0, wantToFlip = 0, error = 0;
    int i, b, out_char_count;

    printf("\n--- BIT STUFFING CONFIGURATION ---\nEnter data input string: ");
    scanf("%99s", inputString);
    str_to_ascii(inputString, ascii_arr, &str_len);

    for (i = 0; i < str_len; i++) {
        ascii_to_bin((char)ascii_arr[i], bin_str);
        for (b = 0; b < 8; b++) data[n++] = (bin_str[b] == '1') ? 1 : 0;
    }

    printf("\n--- TRANSMITTER SIDE ---\nInput String : %s\n", inputString);
    printBits("Original Bin : ", data, n);

    for (i = 0; i < n; i++) {
        stuffed[j++] = data[i];
        ones = (data[i] == 1) ? ones + 1 : 0;
        if (ones == 5) { stuffed[j++] = 0; ones = 0; }
    }
    stuffedLen = j;
    printBits("Stuffed Bin  : ", stuffed, stuffedLen);

    for (i = 0; i < flagLen; i++) framed[k++] = flag[i];
    for (i = 0; i < stuffedLen; i++) framed[k++] = stuffed[i];
    for (i = 0; i < flagLen; i++) framed[k++] = flag[i];
    framedLen = k;
    printBits("Framed Bin   : ", framed, framedLen);

    memcpy(originalFramedBackup, framed, framedLen * sizeof(int));
    printf("\nDo you want to flip a bit to simulate an error? (1=Yes, 0=No): ");
    scanf("%d", &wantToFlip);

    if (wantToFlip == 1) {
        int flipIndex = 0;
        printf("Enter bit index to flip (0 to %d): ", framedLen - 1);
        scanf("%d", &flipIndex);
        if (flipIndex >= 0 && flipIndex < framedLen) {
            framed[flipIndex] = !framed[flipIndex];
            printBits("Corrupted Bin: ", framed, framedLen);
        }
    }

    printf("\n--- RECEIVER SIDE ---\n");
    for (i = 0; i < flagLen; i++) {
        if (framed[i] != flag[i] || framed[framedLen - flagLen + i] != flag[i]) error = 1;
    }

    if (!error) {
        ones = 0; j = 0;
        for (i = flagLen; i < framedLen - flagLen; i++) {
            if (ones == 5) {
                if (framed[i] != 0) { error = 1; break; }
                ones = 0; continue;
            }
            destuffed[j++] = framed[i];
            ones = (framed[i] == 1) ? ones + 1 : 0;
        }
        destuffedLen = j;
    }
    if (destuffedLen != n) {
        error = 1;
    } else {
        /* Payload verification: compare actual bits, not just length.
           NOTE: this only works because sender and receiver state live
           in the same process (a simulator shortcut). A real receiver
           has no copy of the original data to diff against -- that's
           exactly why real protocols carry a CRC/checksum computed by
           the sender and independently recomputed by the receiver,
           rather than relying on an out-of-band original to compare to. */
        for (i = 0; i < n; i++) {
            if (destuffed[i] != data[i]) { error = 1; break; }
        }
    }

    if (!error) {
        printBits("Destuffed data: ", destuffed, destuffedLen);
        out_char_count = 0;
        for (i = 0; i < destuffedLen; i += 8) {
            for (b = 0; b < 8; b++) bin_str[b] = (destuffed[i + b] == 1) ? '1' : '0';
            out_ascii_arr[out_char_count++] = bin_to_ascii(bin_str);
        }
        ascii_to_str(out_ascii_arr, out_char_count, outputString);
        printf("Output Text  : %s\nData matches perfectly!\n", outputString);
    } else {
        printBits("Actual data:    ", originalFramedBackup, framedLen);
        printBits("Changed data:   ", framed, framedLen);
        printf("Both don't match, so message discarded.\n");
    }
}

/* ==========================================
   METHOD 2: BYTE STUFFING COMPONENT (FIXED)
   - No more 'F'/'E' letter hijack: input string is stored byte-for-byte,
     so plain text containing F or E stuffs/destuffs correctly.
   - Explicit injection step lets you force a SOF, EOF, or ESC byte value
     into ANY position(s) in the data -- including non-printable custom
     values and multiple/adjacent collisions -- which is what makes every
     collision scenario constructible (EOF collisions were impossible
     before, since there was no way to insert that byte value at all).
   - Boundary check for a dangling ESC at the end of the frame is kept,
     so an ESC injected as the very last data byte is still escaped and
     destuffed correctly instead of falsely tripping an error.
   - Payload corruption: flips a single chosen bit inside a chosen
     payload byte (SOF/EOF markers are out of scope), simulating a
     realistic transmission error rather than an arbitrary overwrite.
     Multiple flips across multiple bytes can be applied per run.
   ========================================== */
void byteStuffing() {
    char inputString[MAX_STR], ebits[9], sofChoice[9], eofChoice[9], outputString[MAX_STR];
    int ascii_arr[MAX_STR], originalFramedBackup[MAX_BYTES], out_ascii_arr[MAX_STR];
    int str_len = 0, stuffedLen = 0, framedLen = 0, destuffedLen = 0, sofByte, eofByte, wantToCorrupt = 0, error = 0, j = 0, k = 0;
    int i;
    int injectChoice = 0, injectWhich = 0, injectPos = 0;

    printf("\n--- BYTE STUFFING CONFIGURATION ---\n");
    printf("Enter Start of Frame (1 for default 01111110): "); scanf("%8s", sofChoice);
    sofByte = (strcmp(sofChoice, "1") == 0) ? 0x7E : (int)bin_to_ascii(sofChoice);

    printf("Enter End of Frame (1 for default 01111110): "); scanf("%8s", eofChoice);
    eofByte = (strcmp(eofChoice, "1") == 0) ? 0x7E : (int)bin_to_ascii(eofChoice);

    printf("Enter Escape byte (8 bits): "); scanf("%8s", ebits);
    escByte = (int)bin_to_ascii(ebits);

    printf("Enter data input string: "); scanf(" %99[^\n]", inputString);
    str_to_ascii(inputString, ascii_arr, &str_len);

    if (str_len == 0) {
        printf("Empty input string -- nothing to frame.\n");
        return;
    }

    /* Take the string literally, byte-for-byte. No letter is special. */
    for (i = 0; i < str_len; i++) dataBytes[i] = ascii_arr[i];

    /* --- Injection step: reach every possible test case --- */
    printf("\nDo you want to inject a special byte into the data for testing? (1=Yes, 0=No): ");
    scanf("%d", &injectChoice);
    while (injectChoice == 1) {
        printf("Inject which byte? (1=SOF, 2=EOF, 3=ESC): ");
        scanf("%d", &injectWhich);
        printf("Enter position in data (0 to %d): ", str_len - 1);
        scanf("%d", &injectPos);
        if (injectPos >= 0 && injectPos < str_len) {
            if (injectWhich == 1) dataBytes[injectPos] = sofByte;
            else if (injectWhich == 2) dataBytes[injectPos] = eofByte;
            else if (injectWhich == 3) dataBytes[injectPos] = escByte;
            else printf("Invalid choice, ignored.\n");
        } else {
            printf("Invalid position, ignored.\n");
        }
        printf("Inject another? (1=Yes, 0=No): ");
        scanf("%d", &injectChoice);
    }

    printf("\n--- TRANSMITTER SIDE ---\nSOF = "); printByteArray(sofByte);
    printf("\nEOF = "); printByteArray(eofByte);
    printf("\nESC = "); printByteArray(escByte); printf("\n");
    printBytesAsBinary("Original data: ", dataBytes, str_len);

    j = 0;
    for (i = 0; i < str_len; i++) {
        if (dataBytes[i] == sofByte || dataBytes[i] == eofByte || dataBytes[i] == escByte) {
            stuffedBytes[j++] = escByte;
        }
        stuffedBytes[j++] = dataBytes[i];
    }
    stuffedLen = j;
    printBytesAsBinary("Stuffed data : ", stuffedBytes, stuffedLen);

    k = 0;
    framedBytes[k++] = sofByte;
    for (i = 0; i < stuffedLen; i++) framedBytes[k++] = stuffedBytes[i];
    framedBytes[k++] = eofByte;
    framedLen = k;
    printBytesAsBinary("Framed data  : ", framedBytes, framedLen);

    memcpy(originalFramedBackup, framedBytes, framedLen * sizeof(int));

    /* --- PAYLOAD CORRUPTION ---
       Scoped to the stuffed payload only (indices 1 .. framedLen-2),
       so SOF/EOF markers can never be corrupted by accident here --
       that keeps this a clean "bit got flipped in transit" test rather
       than a "framing byte got destroyed" test. Corruption is a single
       bit-flip within a chosen payload byte, which is how real
       transmission noise actually behaves (one bit at a time), not an
       arbitrary decimal overwrite. You can flip multiple bits across
       multiple payload bytes in one run to simulate burst errors. */
    printf("\nDo you want to corrupt the payload? (1=Yes, 0=No): ");
    scanf("%d", &wantToCorrupt);

    while (wantToCorrupt == 1) {
        int payloadLen = framedLen - 2; /* excludes SOF at [0] and EOF at [framedLen-1] */
        int corruptIndex = 0, bitPos = 0;

        if (payloadLen <= 0) {
            printf("No payload bytes to corrupt (frame is empty).\n");
            break;
        }

        printf("Enter payload byte index to corrupt (0 to %d): ", payloadLen - 1);
        scanf("%d", &corruptIndex);

        if (corruptIndex < 0 || corruptIndex >= payloadLen) {
            printf("Invalid payload index, ignored.\n");
        } else {
            printf("Enter bit position to flip within that byte (0=LSB .. 7=MSB): ");
            scanf("%d", &bitPos);
            if (bitPos < 0 || bitPos > 7) {
                printf("Invalid bit position, ignored.\n");
            } else {
                int frameIndex = corruptIndex + 1; /* shift past SOF */
                framedBytes[frameIndex] ^= (1 << bitPos);
                printf("Flipped bit %d of payload byte %d (frame index %d).\n",
                       bitPos, corruptIndex, frameIndex);
                printBytesAsBinary("Corrupted data: ", framedBytes, framedLen);
            }
        }

        printf("Corrupt another payload bit? (1=Yes, 0=No): ");
        scanf("%d", &wantToCorrupt);
    }

    printf("\n--- RECEIVER SIDE ---\n");
    if (framedBytes[0] != sofByte || framedBytes[framedLen - 1] != eofByte) error = 1;

    if (!error) {
        j = 0;
        for (i = 1; i < framedLen - 1; i++) {
            if (framedBytes[i] == escByte) {
                i++; /* skip escape marker, take next byte literally */
                if (i >= framedLen - 1) { error = 1; break; } /* dangling ESC */
            }
            destuffedBytes[j++] = framedBytes[i];
        }
        destuffedLen = j;
    }

    if (!error && destuffedLen == str_len) {
        /* Payload verification: compare actual bytes against the
           original dataBytes, not just the destuffed length. Same
           simulator-only caveat as bit stuffing above -- a real
           receiver would use a CRC/checksum here instead, since it
           has no independent copy of dataBytes to diff against. */
        for (i = 0; i < destuffedLen; i++) {
            if (destuffedBytes[i] != dataBytes[i]) { error = 1; break; }
        }
    }

    if (!error && destuffedLen == str_len) {
        printBytesAsBinary("Destuffed data: ", destuffedBytes, destuffedLen);
        for (i = 0; i < destuffedLen; i++) out_ascii_arr[i] = destuffedBytes[i];
        ascii_to_str(out_ascii_arr, destuffedLen, outputString);
        printf("Output Text  : %s\nData matches perfectly!\n", outputString);
    } else {
        printBytesAsBinary("Actual data:    ", originalFramedBackup, framedLen);
        printBytesAsBinary("Changed data:   ", framedBytes, framedLen);
        printf("Payload corrupted -- both don't match, so message discarded.\n");
    }
}

/* ==========================================
   MAIN MENU INTERFACE DRIVER
   ========================================== */
int main() {
    int choice;
    while (1) {
        printf("\n=== STUFFING SIMULATOR INTERFACE ===\n");
        printf("1. Bit Stuffing & Framing\n");
        printf("2. Byte Stuffing & Framing\n");
        printf("3. Exit System\n");
        printf("Enter selection: ");
        if (scanf("%d", &choice) != 1) break;

        if (choice == 3) {
            printf("Shutting down sequence. Goodbye.\n");
            break;
        }
        switch (choice) {
            case 1: bitStuffing();  break;
            case 2: byteStuffing(); break;
            default: printf("Invalid option choice. Retry.\n");
        }
    }
    return 0;
}
